# ─── Database ────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/dhaka_tesla

# ─── Backend ─────────────────────────────────────────────────
# Port the Express API listens on
PORT=3001

# Secret used to sign JWT tokens — use a long random string in production
JWT_SECRET=53dc8a0f-c2e7-40a1-9f6e-488b1b4f72e5 

# ─── Frontend ────────────────────────────────────────────────
# Base URL of the backend API, used by Next.js
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Docker (used by docker-compose.yml) ─────────────────────
POSTGRES_DB=dhaka_tesla
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
